# Copie para .env e preencha com os dados do projeto Supabase
# (Project Settings -> API). A chave publicavel e publica por natureza: quem
# protege os dados e o RLS da migration em supabase/migrations.
QCLI_SUPABASE_URL=https://SEU-PROJETO.supabase.co
QCLI_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Endereco publico do site: e o que vai no link que o barbeiro compartilha
# e no rodape do PDF. Sem barra no final.
QCLI_SITE_URL=https://metodo-vic.pages.dev
